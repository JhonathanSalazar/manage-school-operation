# Server
NODE_ENV=development
PORT=5007

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/school_mgmt

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CSRF
CSRF_SECRET=change_me_csrf_secret_min_32_chars

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here

# Frontend
FRONTEND_URL=http://localhost:5173

# Java service internal auth
JAVA_INTERNAL_SECRET=change_me_internal_secret_min_32_chars
